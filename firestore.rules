rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isStudioAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'dimensi.idphoto@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/admin_staff/$(request.auth.uid))
      );
    }

    function isValidBooking(data) {
      return data.clientName is string && data.clientName.size() >= 2 && data.clientName.size() <= 100 &&
        data.phone is string && data.phone.size() >= 6 && data.phone.size() <= 30 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
        data.packageId is string && data.packageId.size() > 0 && data.packageId.size() <= 60 &&
        data.packageName is string && data.packageName.size() > 0 && data.packageName.size() <= 120 &&
        data.packagePrice is number && data.packagePrice >= 0 &&
        (!('addOnIds' in data) || (data.addOnIds is list && data.addOnIds.size() <= 20)) &&
        (!('addOnsText' in data) || (data.addOnsText is string && data.addOnsText.size() <= 500)) &&
        (!('addOnsTotal' in data) || (data.addOnsTotal is number && data.addOnsTotal >= 0)) &&
        data.totalPrice is number && data.totalPrice >= 0 &&
        data.sessionDate is string && data.sessionDate.size() <= 30 &&
        data.sessionTime is string && data.sessionTime.size() <= 30 &&
        data.locationType is string && data.locationType in ['studio', 'outdoor', 'venue'] &&
        data.locationAddress is string && data.locationAddress.size() <= 300 &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
        (!('driveFolderId' in data) || (data.driveFolderId is string && data.driveFolderId.size() <= 200)) &&
        (!('driveFolderUrl' in data) || (data.driveFolderUrl is string && data.driveFolderUrl.size() <= 500)) &&
        (!('selectedPrintFiles' in data) || (data.selectedPrintFiles is string && data.selectedPrintFiles.size() <= 2000)) &&
        (!('selectedPrintFilesNote' in data) || (data.selectedPrintFilesNote is string && data.selectedPrintFilesNote.size() <= 1000)) &&
        (!('selectedPrintFilesUpdatedAt' in data) || (data.selectedPrintFilesUpdatedAt is string && data.selectedPrintFilesUpdatedAt.size() <= 100)) &&
        data.status is string && data.status in ['Menunggu Konfirmasi', 'Terkonfirmasi & Terjadwal', 'Proses Editing', 'Selesai', 'Dibatalkan'] &&
        data.paymentPreference is string && data.paymentPreference in ['DP 30%', 'DP 50%', 'Lunas'];
    }

    function isValidReview(data) {
      return data.clientName is string && data.clientName.size() >= 2 && data.clientName.size() <= 100 &&
        data.packageName is string && data.packageName.size() > 0 && data.packageName.size() <= 120 &&
        data.rating is number && data.rating >= 1 && data.rating <= 5 &&
        (!('review' in data) || (data.review is string && data.review.size() <= 2000));
    }

    // Admins Collection
    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isStudioAdmin());
      allow list: if isStudioAdmin();
      allow create, update, delete: if isStudioAdmin();
    }

    // Bookings Collection (Customer Orders & Photoshoot Schedules)
    match /bookings/{bookingId} {
      allow get, list: if true;
      allow create: if isValidId(bookingId) && isValidBooking(incoming());
      allow update: if isValidId(bookingId) && (isStudioAdmin() || isValidBooking(incoming()));
      allow delete: if isStudioAdmin();
    }

    // Packages Collection (Studio Photography Packages)
    match /packages/{packageId} {
      allow get, list: if true;
      allow create, update, delete: if isStudioAdmin() || (isValidId(packageId) && incoming().name is string && incoming().price is number);
    }

    // Addons Collection (Extra Services)
    match /addons/{addonId} {
      allow get, list: if true;
      allow create, update, delete: if isStudioAdmin() || (isValidId(addonId) && incoming().name is string && incoming().price is number);
    }

    // Portfolios Collection (Visual Gallery)
    match /portfolios/{portfolioId} {
      allow get, list: if true;
      allow create, update, delete: if isStudioAdmin() || (isValidId(portfolioId) && incoming().imageUrl is string);
    }

    // Reviews Collection (Customer Ratings & Testimonials)
    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create, update: if isValidId(reviewId) && isValidReview(incoming());
      allow delete: if isStudioAdmin();
    }

    // Settings Collection (Studio Configuration & Bank Accounts)
    match /settings/{settingId} {
      allow get, list: if true;
      allow create, update: if isStudioAdmin() || isValidId(settingId);
      allow delete: if isStudioAdmin();
    }

    // Admin Staff Collection (Staff Directory & Roles)
    match /admin_staff/{staffId} {
      allow get, list: if true;
      allow create, update: if isStudioAdmin() || (isValidId(staffId) && incoming().name is string && incoming().email is string);
      allow delete: if isStudioAdmin();
    }

    // Audit Logs Collection (Security & Operation Trail - IMMUTABLE)
    match /audit_logs/{logId} {
      allow get, list: if true;
      allow create: if isValidId(logId) && incoming().action is string && incoming().actor is string;
      // Strict security: Never allow modifying or deleting audit logs to prevent tampering
      allow update, delete: if false;
    }

    // Connection test document
    match /test/{testId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
